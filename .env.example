# Meta Model API key (dev.meta.ai -> API keys)
MODEL_API_KEY=

# Signs visit tickets. Any long random string; required in production.
VISIT_SECRET=

# Cloudflare R2 bucket for write-once objects (S3 API). Leave R2_BUCKET empty in dev
# to write to ./data instead. The token needs Object Read & Write on this bucket only.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local storage folder when R2_BUCKET is empty
DATA_DIR=./data
