# Meta Model API key (dev.meta.ai -> API keys)
MODEL_API_KEY=

# Signs visit tickets. Any long random string; required in production.
VISIT_SECRET=

# Vercel Blob read/write token. Leave empty in dev to write to ./data instead.
BLOB_READ_WRITE_TOKEN=

# Local storage folder when BLOB_READ_WRITE_TOKEN is empty
DATA_DIR=./data
