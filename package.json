{
  "name": "plumbline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "spike": "tsx --env-file-if-exists=.env.local scripts/sam-spike.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "spike:video": "tsx --env-file-if-exists=.env.local scripts/video-spike.ts",
    "walk": "tsx --env-file-if-exists=.env.local scripts/walk-count.ts",
    "e2e": "tsx --env-file-if-exists=.env.local scripts/e2e.ts",
    "replay": "tsx --env-file-if-exists=.env.local scripts/replay.ts",
    "showcase": "tsx scripts/build-showcase.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "@vercel/blob": "^2.8.2",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.64.0",
    "next": "15.5.28",
    "openai": "^7.45.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "ffmpeg-static": "^5.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
